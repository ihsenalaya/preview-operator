\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Provenance graph schema} (W3C PROV typing). PR/Preview/Namespace and the four evidence classes are \emph  {entities}; \texttt  {EvidenceCollection} is an \emph  {activity} triggered at \texttt  {failureDetectedAt} by the \emph  {agent} \texttt  {preview-operator}; edges instantiate \texttt  {wasDerivedFrom}, \texttt  {used}, \texttt  {wasAssociatedWith}, \texttt  {wasGeneratedBy}. The FailureReport\xspace  {} CR collects all four evidence types and outlives the namespace.\relax }}{4}{figure.caption.12}\protected@file@percent }
\newlabel{fig:provenance-graph}{{2}{4}{\textbf {Provenance graph schema} (W3C PROV typing). PR/Preview/Namespace and the four evidence classes are \emph {entities}; \texttt {EvidenceCollection} is an \emph {activity} triggered at \texttt {failureDetectedAt} by the \emph {agent} \texttt {preview-operator}; edges instantiate \texttt {wasDerivedFrom}, \texttt {used}, \texttt {wasAssociatedWith}, \texttt {wasGeneratedBy}. The \fp {} CR collects all four evidence types and outlives the namespace.\relax }{figure.caption.12}{}}
